# ---------------------------------------------------------------------------
# IFAL Consult — environment variables
# Copy to .env.local for local dev, or set these in the Vercel dashboard.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, OG tags, OAuth callbacks)
NEXT_PUBLIC_SITE_URL="https://intadvisorsltd.com.ng"

# --- Google Tag Manager ---------------------------------------------------
# Container ID. Other tags (GA4, Meta Pixel, LinkedIn, etc.) are managed
# INSIDE GTM — no code changes needed to add them.
NEXT_PUBLIC_GTM_ID="GTM-TMPLR62L"

# --- Auth.js / NextAuth ----------------------------------------------------
# Generate a secret with:  openssl rand -base64 32
AUTH_SECRET=""
# On Vercel this is set automatically; set explicitly for other hosts.
# AUTH_URL="https://intadvisorsltd.com.ng"

# Google OAuth  (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# LinkedIn OAuth  (https://www.linkedin.com/developers/apps -> Sign In with LinkedIn using OpenID Connect)
AUTH_LINKEDIN_ID=""
AUTH_LINKEDIN_SECRET=""

# Facebook OAuth  (https://developers.facebook.com/apps -> Facebook Login)
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# --- Contact form delivery -------------------------------------------------
# Where consultation requests are delivered.
CONTACT_TO_EMAIL="info@intadvisorsltd.com.ng"
# Resend API key (https://resend.com) — used if present; otherwise the form
# logs the submission server-side and still returns success to the user.
RESEND_API_KEY=""
# Verified "from" address for Resend (must be on a domain you verified).
CONTACT_FROM_EMAIL="IFAL Consult <noreply@intadvisorsltd.com.ng>"
